{
  "name": "restaurant-platform",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.17.0",
  "engines": {
    "node": ">=24 <25"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx packages/database/src/seed.ts",
    "build:packages": "tsc -p packages/shared-types && tsc -p packages/validation && tsc -p packages/database",
    "build:api": "npm run build:packages && tsc -p apps/api/tsconfig.build.json",
    "build": "npm run db:generate && npm run build:api && npm run build -w @restaurant/admin",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "npm run build:packages && tsc -p apps/api --noEmit && tsc -p packages/ui --noEmit && tsc -p apps/admin --noEmit",
    "test": "vitest run",
    "test:integration": "npm run db:generate && npm run build:api && node scripts/integration.mjs",
    "test:e2e": "npm run build && node scripts/integration.mjs --browser",
    "dev:api": "node --env-file=.env apps/api/dist/main.js",
    "dev:admin": "npm run dev -w @restaurant/admin",
    "verify:docker": "docker compose --env-file .env -f infrastructure/docker/compose.yml config --quiet",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "demo:menu": "node scripts/demo-menu.mjs"
  },
  "overrides": {
    "multer": "2.3.0",
    "mysql2": "3.24.4",
    "deepmerge-ts": "8.0.2"
  },
  "devDependencies": {
    "embedded-postgres": "17.10.0-beta.17",
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.58.0",
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/supertest": "^6.0.3",
    "@nestjs/testing": "11.2.3",
    "dotenv": "^17.2.0",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "globals": "^16.5.0",
    "prettier": "^3.7.0",
    "prisma": "7.10.0",
    "supertest": "^7.2.0",
    "tsx": "^4.21.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0",
    "vitest": "^4.0.0"
  }
}
