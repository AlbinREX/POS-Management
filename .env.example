# Copy to .env and replace every CHANGE_ME. Never commit .env.
#
# Production refuses to start on placeholder or weak values. It requires a database
# password that is not a placeholder and is at least 24 characters, a high-entropy
# JWT_SECRET, and a non-loopback HTTPS APP_ORIGIN. Generate secrets with:
#   node -e "console.log(require('node:crypto').randomBytes(48).toString('hex'))"
NODE_ENV=development
PORT=4000
APP_ORIGIN=http://localhost:3000
API_INTERNAL_URL=http://127.0.0.1:4000
TRUST_PROXY=0
JWT_SECRET=CHANGE_ME_GENERATE_64_OR_MORE_RANDOM_CHARACTERS
POSTGRES_DB=restaurant
POSTGRES_USER=restaurant_migrator
POSTGRES_PASSWORD=CHANGE_ME_RANDOM_DATABASE_OWNER_PASSWORD
APP_DATABASE_PASSWORD=CHANGE_ME_RANDOM_RUNTIME_PASSWORD
# URL-encode password components. The runtime role cannot migrate or mutate audit history.
DATABASE_URL=postgresql://restaurant_app:CHANGE_ME_RANDOM_RUNTIME_PASSWORD@localhost:5432/restaurant
MIGRATION_DATABASE_URL=postgresql://restaurant_migrator:CHANGE_ME_RANDOM_DATABASE_OWNER_PASSWORD@localhost:5432/restaurant
SEED_ORGANIZATION_SLUG=CHANGE_ME
SEED_ORGANIZATION_NAME=CHANGE_ME
SEED_BRANCH_CODE=CHANGE_ME
SEED_BRANCH_NAME=CHANGE_ME
SEED_OWNER_NAME=CHANGE_ME
SEED_OWNER_EMAIL=owner@example.invalid
SEED_OWNER_PASSWORD=CHANGE_ME_MINIMUM_12_CHARACTERS
# Optional. Where the API reads backup health from; defaults to the mounted /backups.
# BACKUP_STATUS_FILE=/backups/backup-status.json
# Optional. Phase 12 cloud delivery target. Leave unset for a restaurant that does not
# replicate; delivery is then inert and reported as disabled.
# SYNC_TARGET_URL=
# Phase 14 fiscal handoff to EnterNet / F-LINK. FastFood Riza does not fiscalize: EnterNet
# operates the fiscal device and F-LINK software. These are placeholders only. The real
# F-LINK transport is not implemented, so leave FLINK_ENABLED=false until EnterNet supplies
# their integration specification; final names and semantics follow their contract.
FISCAL_PROVIDER=enternet-flink
FLINK_ENABLED=false
FLINK_ENDPOINT=
FLINK_CONNECTION_MODE=
FLINK_TIMEOUT_MS=
