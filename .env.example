# Copy to .env and replace every CHANGE_ME. Never commit .env.
NODE_ENV=development
PORT=4000
APP_ORIGIN=http://localhost:3000
API_INTERNAL_URL=http://127.0.0.1:4000
TRUST_PROXY=0
JWT_SECRET=CHANGE_ME_GENERATE_64_OR_MORE_RANDOM_CHARACTERS
POSTGRES_DB=restaurant
POSTGRES_USER=restaurant_migrator
POSTGRES_PASSWORD=CHANGE_ME_RANDOM_DATABASE_OWNER_PASSWORD
APP_DATABASE_PASSWORD=CHANGE_ME_RANDOM_RUNTIME_PASSWORD
# URL-encode password components. The runtime role cannot migrate or mutate audit history.
DATABASE_URL=postgresql://restaurant_app:CHANGE_ME_RANDOM_RUNTIME_PASSWORD@localhost:5432/restaurant
MIGRATION_DATABASE_URL=postgresql://restaurant_migrator:CHANGE_ME_RANDOM_DATABASE_OWNER_PASSWORD@localhost:5432/restaurant
SEED_ORGANIZATION_SLUG=CHANGE_ME
SEED_ORGANIZATION_NAME=CHANGE_ME
SEED_BRANCH_CODE=CHANGE_ME
SEED_BRANCH_NAME=CHANGE_ME
SEED_OWNER_NAME=CHANGE_ME
SEED_OWNER_EMAIL=owner@example.invalid
SEED_OWNER_PASSWORD=CHANGE_ME_MINIMUM_12_CHARACTERS
